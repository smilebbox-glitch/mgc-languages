# MGC Languages multi-user LAN profile.
# Recommended: use start-lan.cmd on Windows; it creates .env.lan automatically.
# If you configure this file manually, copy it to .env.lan and replace every CHANGE_ME value.

MGC_BIND_ADDRESS=0.0.0.0
MGC_PORT=8080

# For manual setup use the server LAN IP and/or DNS name, for example:
# MGC_TRUSTED_HOSTS=localhost,127.0.0.1,192.168.10.25,mgc-languages
# '*' is convenient for a closed test LAN but should not be used for Internet-facing deployment.
MGC_TRUSTED_HOSTS=*

POSTGRES_DB=mgc_languages
POSTGRES_USER=mgc_languages
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

MGC_ADMIN_USERNAME=admin
MGC_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MGC_ADMIN_DISPLAY_NAME=MGC Admin
OIDC_STATE_SECRET=CHANGE_ME_RANDOM_32_BYTES_OR_MORE
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# Local-office profile: users may create individual accounts themselves.
# Corporate rollout should normally switch to OIDC and disable self-registration.
REGISTRATION_ENABLED=true
SESSION_TTL_HOURS=168

# Two workers are a reasonable starting point for an office pilot.
# Increase only after load testing; each worker owns a separate DB connection pool.
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

TTS_ENABLED=true
TTS_CONCURRENCY=2

# Same-origin browser UI does not need CORS. Fill only for a separate frontend origin.
CORS_ORIGINS=
