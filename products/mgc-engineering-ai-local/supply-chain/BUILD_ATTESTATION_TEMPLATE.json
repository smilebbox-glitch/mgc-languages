  "release": "6.3.12",
  "production_authorized": false,
  "required_evidence": [
    "BUILD_INPUTS SHA-256",
    "frontend package-lock",
    "three Python hashed locks",
    "three wheelhouse manifests",
    "CycloneDX SBOM",
