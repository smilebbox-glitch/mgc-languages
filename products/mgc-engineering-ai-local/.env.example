APP_NAME=MGC Engineering AI Local v6.3.30
APP_ENV=prod
AIR_GAPPED_MODE=true
# auto = use NVIDIA GPU when available, otherwise CPU; can be forced to cpu/gpu.
MGC_RUNTIME=auto
INFERENCE_RUNTIME=gpu
API_KEY=replace-with-long-random-value
AUTH_MODE=oidc
ENGINEER_ONLY_ACCESS=true
ENGINEER_ACCESS_GROUPS=engineering-ai-users,engineering-ai-admins
ENGINEERING_ADMIN_GROUPS=engineering-ai-admins
API_KEY_GROUPS=engineering-ai-users,engineering-ai-admins
ALLOW_API_KEY_AUTH_IN_PROD=false
POSTGRES_PASSWORD=replace-me
NEO4J_PASSWORD=replace-me
MINIO_ACCESS_KEY=mgc
MINIO_SECRET_KEY=replace-me

# All model paths are local and read-only inside containers.
MODELS_ROOT=/models
DOCLING_ARTIFACTS_PATH=/models/docling
LOCAL_INFERENCE_ALLOWED_HOSTS=model-server,vision-server,localhost,127.0.0.1,::1
EMBEDDING_MODEL=/models/embeddings
EMBEDDING_DIM=1024
RERANKER_ENABLED=true
RERANKER_MODEL=/models/reranker

# One local multimodal model serves both Engineering Copilot and drawing vision.
LOCAL_SERVED_MODEL_NAME=mgc-local
LOCAL_MODEL_API_KEY=replace-local-model-key
LLM_BASE_URL=http://model-server:8000/v1
LLM_API_KEY=replace-local-model-key
LLM_MODEL=mgc-local
VLM_BASE_URL=http://model-server:8000/v1
VLM_API_KEY=replace-local-model-key
VLM_MODEL=mgc-local


# CPU runtime (llama.cpp + GGUF). Qwen3-4B Q4_K_M is a practical baseline; approve model/license internally.
CPU_MODEL_FILE=Qwen3-4B-Q4_K_M.gguf
CPU_SERVED_MODEL_NAME=mgc-local-cpu
CPU_CONTEXT_SIZE=8192
CPU_LLM_MAX_TOKENS=800
CPU_LLM_TIMEOUT_SECONDS=300
CPU_THREADS=8
CPU_THREADS_BATCH=8
CPU_PARALLEL=1
CPU_AUX_THREADS=4
CPU_WORKER_CONCURRENCY=1
CPU_RERANKER_ENABLED=true
MGC_CPU_VISION=false

# Optional CPU Vision (requires a compatible multimodal GGUF + matching mmproj).
CPU_VLM_MODEL_FILE=
CPU_VLM_MMPROJ_FILE=
CPU_VLM_SERVED_MODEL_NAME=mgc-local-cpu-vision
CPU_VLM_CONTEXT_SIZE=8192
CPU_VLM_TIMEOUT_SECONDS=900

# vLLM sizing; tune to approved GPU hardware.
VLLM_GPU_COUNT=1
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=32768

# Runtime must never contact Hugging Face or other public endpoints.
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1

ENGINEERING_SHARE_PATH=./inbox
STORAGE_DIR=/data/storage
INBOX_DIR=/data/inbox
MAX_UPLOAD_MB=1000
ASYNC_INGEST=false
SCANNER_ENABLED=true
GRAPH_ENABLED=false
OBJECT_STORE_ENABLED=false
# Non-production only; used by `make pilot`.
PILOT_BIND_IP=127.0.0.1
PILOT_PORT=3000

# Image names must already exist on the target host or point to an internal registry.
MGC_API_IMAGE=mgc-engineering-ai-api:6.3.30-local
MGC_FRONTEND_IMAGE=mgc-engineering-ai-frontend:6.3.30-local
MGC_GATEWAY_IMAGE=mgc-engineering-ai-gateway:6.3.30-local
MGC_WEBHOOK_IMAGE=mgc-engineering-ai-webhook-edge:6.3.30-local
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:REPLACE_WITH_APPROVED_SERVER_VERSION
VLLM_IMAGE=vllm/vllm-openai:latest
POSTGRES_IMAGE=postgres:16
QDRANT_IMAGE=qdrant/qdrant:latest
REDIS_IMAGE=redis:7-alpine
NEO4J_IMAGE=neo4j:5-community
MINIO_IMAGE=minio/minio:latest

# Optional integrations retained from Pilot v3
PLM_API_TOKEN=
ERP_API_TOKEN=
CAD_GATEWAY_TOKEN=
INTEGRATION_SYNC_ENABLED=false
INTEGRATION_SYNC_INTERVAL_SECONDS=300
INTEGRATION_SYNC_DEFAULT_MINUTES=15
INTEGRATION_SYNC_PAGE_LIMIT=100
INTEGRATION_SYNC_MAX_PAGES=20
WEBHOOK_MAX_SKEW_SECONDS=300
PLM_WEBHOOK_SECRET=
PLM_OAUTH_CLIENT_SECRET=
PLM_MTLS_CERT_PATH=
PLM_MTLS_KEY_PATH=
WEBHOOK_PORT=3003

# Optional OIDC/SSO retained from Pilot v3; all endpoints must remain internal.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_GROUPS_CLAIM=groups
OIDC_USER_CLAIM=preferred_username
SSO_ISSUER_URL=
SSO_CLIENT_ID=mgc-engineering-ai
SSO_CLIENT_SECRET=
SSO_COOKIE_SECRET=
SSO_COOKIE_SECURE=true
SSO_PORT=3000

# Engineer-only SSO edge. Pin and import this image before air-gapped deployment.
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:REPLACE_WITH_APPROVED_VERSION
ENGINEER_SSO_GROUP=engineering-ai-users
ENGINEERING_ADMIN_SSO_GROUP=engineering-ai-admins
SSO_BIND_IP=127.0.0.1

# v6.0.2 production health / startup hardening
HEALTH_TIMEOUT_SECONDS=2
READINESS_REQUIRE_REDIS=true
READINESS_REQUIRE_QDRANT=true
MIGRATION_LOCK_TIMEOUT_SECONDS=60
# Backup target should normally be a separately protected filesystem/appliance.
MGC_BACKUP_ROOT=./backups

# v6.3.21 consistency-verified Backup / Restore / PITR readiness
MGC_BACKUP_QUIESCE=true
MGC_BACKUP_DRAIN_TIMEOUT_SECONDS=120
MGC_BACKUP_REQUIRE_CLEAN_DRAIN=true
# Optional PostgreSQL WAL archiving. Enable only after MGC_PITR_ARCHIVE_PATH is an approved, separately protected writable target.
MGC_PITR_ENABLED=false
MGC_PITR_ARCHIVE_PATH=/srv/mgc-wal-archive
MGC_PITR_ARCHIVE_TIMEOUT=300s

# v6.0.2 integration concurrency hardening
INTEGRATION_SYNC_LOCK_TIMEOUT_SECONDS=30

# v6.3.2 enterprise deployment hardening
OIDC_ALLOWED_ALGORITHMS=RS256,RS384,RS512,ES256
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_REQUIRED_CLAIMS=exp,iat,sub
OIDC_REQUIRED_ACR_VALUES=
OIDC_ALLOWED_JWKS_HOSTS=
ALLOW_INSECURE_OIDC_IN_PROD=false
ALLOW_TRUSTED_HEADERS_IN_PROD=false
TRUSTED_PROXY_SECRET=
AUDIT_MIN_RETENTION_DAYS=365
AUDIT_EXPORT_MAX_ROWS=5000
SECURITY_REQUIRE_TLS_EDGE=true
# Enterprise overlay requires distinct PostgreSQL roles/credentials.
MGC_RUNTIME_DATABASE_URL=
MGC_MIGRATION_DATABASE_URL=
MGC_TLS_CERT_DIR=./certs
ENTERPRISE_BIND_IP=0.0.0.0
ENTERPRISE_HTTPS_PORT=443
ENTERPRISE_MTLS_BIND_IP=0.0.0.0
ENTERPRISE_MTLS_PORT=9443
MGC_ENTERPRISE_EDGE_IMAGE=mgc-engineering-ai-enterprise-edge:6.3.30-local
# Approved build host: fail when Trivy/Grype is unavailable.
MGC_REQUIRE_CVE_SCANNER=true

# v6.3.2 observability / reliability / production support
OPERATIONAL_SAMPLING_ENABLED=false
OPERATIONAL_SAMPLING_INTERVAL_SECONDS=60
OPERATIONAL_HEALTH_RETENTION_DAYS=30
SLO_DEPENDENCY_AVAILABILITY_TARGET=0.995
SLO_INTEGRATION_FRESHNESS_TARGET=0.95
SLO_QUEUE_MAX_AGE_SECONDS=300
OPERATIONS_DEFAULT_WINDOW_MINUTES=60
SUPPORT_BUNDLE_MAX_INCIDENTS=100
# v6.3.30: optional DB materialization of automated operational signals.
# Evidence generation itself remains available even when this is false.
AUTOMATED_INCIDENT_MATERIALIZATION_ENABLED=false

# v6.2 simplified runtime profile: core | ai | advanced
# Container images bake the same profile selected at build time; do not set MGC_BUILD_PROFILE manually.
DEPLOYMENT_PROFILE=ai
FEATURES_ENABLED=
FEATURES_DISABLED=
VECTOR_ENABLED=true

# v6.3.2 transactional outbox / rebuildable projections
PROJECTION_OUTBOX_ENABLED=true
PROJECTION_WORKER_ENABLED=true
PROJECTION_WORKER_INTERVAL_SECONDS=10
PROJECTION_BATCH_SIZE=20
PROJECTION_MAX_ATTEMPTS=8
PROJECTION_RETRY_BASE_SECONDS=5
PROJECTION_RETRY_MAX_SECONDS=900
PROJECTION_LOCK_TIMEOUT_SECONDS=300
PROJECTION_LAG_WARNING_SECONDS=300

# v6.3.5 controlled approval governance
ALLOW_LEGACY_DIRECT_WI_APPROVAL=false

# v6.3.6 enterprise identity & policy enforcement
IDENTITY_POLICY_ENFORCEMENT_ENABLED=true
PRIVILEGED_ACTIONS_REQUIRE_OIDC_IN_PROD=true
PRIVILEGED_REAUTH_MAX_AGE_SECONDS=900
PRIVILEGED_REQUIRED_ACR_VALUES=
OIDC_ACTOR_TYPE_CLAIM=actor_type
OIDC_SERVICE_ACCOUNT_VALUES=service,service_account,client_credentials
OIDC_CLIENT_ID_CLAIM=azp
GOVERNANCE_POSTGRES_RLS_ENABLED=false
ELECTRONIC_SIGNATURE_MODE=disabled

# v6.3.7 controlled Release Handover. Safe defaults keep deployment read-only.
HANDOVER_WRITE_ENABLED=false
HANDOVER_DRY_RUN_DEFAULT=true
HANDOVER_ALLOWED_TARGET_CODES=
HANDOVER_ALLOWED_HOSTS=
HANDOVER_HTTP_TIMEOUT_SECONDS=30
HANDOVER_MAX_ATTEMPTS=3
HANDOVER_RECONCILIATION_MAX_AGE_SECONDS=3600

# v6.3.8 Data Lifecycle, Retention & Compliance. Safe defaults never delete authoritative evidence.
DATA_LIFECYCLE_AUTHORITATIVE_PURGE_ENABLED=false
DATA_LIFECYCLE_PROJECT_QUOTA_MB=0
DATA_LIFECYCLE_AREA_QUOTA_MB=0
DATA_LIFECYCLE_QUOTA_WARNING_PERCENT=80
DATA_LIFECYCLE_RELEASE_RETENTION_DAYS=3650

# v6.3.9 Database Performance & Scale Hardening. Measure-first defaults.
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_SLOW_QUERY_MS=200
DB_QUERY_BUDGET_MAX_STATEMENTS=40
DB_QUERY_BUDGET_MAX_MS=500
DB_QUERY_BUDGET_ENFORCEMENT_ENABLED=false
CURSOR_PAGE_DEFAULT_LIMIT=100
CURSOR_PAGE_MAX_LIMIT=500
BULK_INGEST_BATCH_SIZE=500
PERFORMANCE_SCALE_PROFILE=pilot_30

# v6.3.10 Cache / read-model performance. Redis remains optional acceleration only.
READ_MODEL_ENABLED=true
READ_MODEL_CACHE_ENABLED=true
READ_MODEL_CACHE_TTL_SECONDS=60
READ_MODEL_PENDING_INVALIDATION_BYPASS=true
OBJECT360_CACHE_TTL_SECONDS=30
OBJECT360_MAX_SECTION_ITEMS=500
DIGITAL_THREAD_DEFAULT_MAX_NODES=280
DIGITAL_THREAD_HARD_MAX_NODES=500

# v6.3.11 Background Jobs / Workload Isolation
JOB_PROJECT_DEFAULT_CONCURRENCY=2
JOB_PROJECT_CAD_CONCURRENCY=1
JOB_PROJECT_AI_CONCURRENCY=1
JOB_MAX_ATTEMPTS_CAP=8
JOB_RETRY_BASE_SECONDS=15
JOB_RETRY_MAX_SECONDS=900
JOB_CANCEL_REVOKE_ENABLED=true
JOB_WORKER_HEARTBEAT_WARNING_SECONDS=300
# v6.3.13 execution recovery / worker lease fencing
JOB_WORKER_LEASE_GRACE_SECONDS=120
JOB_AUTO_RECOVERY_ENABLED=true
JOB_AUTO_RECOVERY_MAX_PER_CYCLE=25
JOB_SCHEDULER_ENABLED=true
JOB_SCHEDULER_INTERVAL_SECONDS=60

# v6.3.15 Operational Resilience / graceful degradation
RESILIENCE_ENABLED=true
RESILIENCE_FAILURE_THRESHOLD=3
RESILIENCE_OPEN_SECONDS=30
# false = PostgreSQL + evidence storage gate Core readiness; optional runtime dependencies brownout instead.
RESILIENCE_STRICT_DEPENDENCY_READINESS=false

# v6.3.21 Rolling Upgrade / Deployment Safety
ROLLING_UPGRADE_ENABLED=true
ROLLING_UPGRADE_MAX_PATCH_SKEW=1
ROLLING_UPGRADE_TASK_ENVELOPE_ENABLED=true
# Keep true only for the controlled 6.3.29 -> 6.3.30 transition; set false after all legacy queued work is retired.
ROLLING_UPGRADE_ALLOW_LEGACY_TASK_ENVELOPES=true
ROLLING_UPGRADE_COMPONENT_REGISTRY_ENABLED=true
DEPLOYMENT_COMPONENT_HEARTBEAT_TTL_SECONDS=120
SCHEDULER_LEADER_LOCK_ENABLED=true
SCHEDULER_LEADER_RETRY_SECONDS=10
WORKER_DRAIN_TIMEOUT_SECONDS=600
WORKER_STOP_GRACE_PERIOD=10m
SCHEDULER_STOP_GRACE_PERIOD=2m

# v6.3.21 Blue/Green Cutover & Rollback Safety
BLUE_GREEN_ENABLED=true
DEPLOYMENT_SLOT=stable
CUTOVER_CANDIDATE_MIN_READY_SAMPLES=3
CUTOVER_POST_SWITCH_SAMPLES=5
CUTOVER_FAILURE_THRESHOLD=2
CUTOVER_SAMPLE_INTERVAL_SECONDS=5
CUTOVER_MAX_PATCH_ROLLBACK_SKEW=1
# v6.3.21 application-tier High Availability. Keep false for the simple/base topology;
# docker-compose.ha.yml enables HA explicitly for API replicas. Physical host/database/storage
# HA still requires approved external infrastructure.
HA_ENABLED=false
HA_MIN_API_REPLICAS=2
HA_MIN_WORKER_REPLICAS_PER_ROLE=2
HA_REQUIRED_WORKER_ROLES=interactive,cpu,io
HA_REQUIRE_SINGLE_SCHEDULER_LEADER=true
HA_GATEWAY_MAX_FAILS=2
HA_GATEWAY_FAIL_TIMEOUT_SECONDS=10

# Optional corporate synthetic/SLO probe executed after each traffic-switch sample.
# CUTOVER_SLO_PROBE_CMD=

# v6.3.21 authoritative PostgreSQL + evidence storage HA (disabled for simple/dev topology)
AUTHORITATIVE_WRITE_FENCE_ENABLED=true
DATABASE_HA_ENABLED=false
DATABASE_HA_REQUIRE_PRIMARY_FOR_WRITES=true
# Set to the pg_control_system() system_identifier of the approved cluster when HA is enabled.
DATABASE_HA_EXPECTED_SYSTEM_IDENTIFIER=
EVIDENCE_HA_ENABLED=false
EVIDENCE_HA_MODE=shared
EVIDENCE_HA_REQUIRE_ACTIVE_FOR_WRITES=true
# Stable corporate storage cluster identifier, e.g. mgc-evidence-prod-01
EVIDENCE_HA_CLUSTER_ID=
EVIDENCE_HA_MARKER_RELATIVE_PATH=.mgc-ha/STORAGE_EPOCH.json
# Override for external PostgreSQL VIP/DNS and replicated/shared evidence mount:
# DATABASE_URL=postgresql+psycopg://mgc:***@postgres-ha-vip:5432/mgc
# MGC_STORAGE_PATH=/srv/mgc-evidence-active
# v6.3.21 Production Topology Certification & SLO Enforcement
PRODUCTION_CERTIFICATION_PROFILE=30
DB_POOL_ADMISSION_CONTROL_ENABLED=true
DB_POOL_SATURATION_WARN_RATIO=0.80
DB_POOL_SATURATION_HARD_RATIO=0.95
DB_POOL_ADMISSION_RETRY_AFTER_SECONDS=3


# v6.3.23 operator-side Production Load Certification. Do not persist real credentials in this file.
MGC_LOAD_CERTIFY_CONFIRM=NO
MGC_LOAD_ALLOW_AUDITED_POSTS=NO
# MGC_LOAD_API_KEY=
# MGC_LOAD_BEARER_TOKEN=

# v6.3.30 External Trust Anchoring & Evidence Retention Governance
RELEASE_PROVENANCE_REGISTRY_ENABLED=false
RELEASE_PROVENANCE_REGISTRY_PATH=/data/storage/.mgc-release-provenance
RELEASE_PROVENANCE_REQUIRE_EXTERNAL_ANCHOR=false
RELEASE_PROVENANCE_REQUIRE_WORM_RECEIPT=false
RELEASE_PROVENANCE_ANCHOR_MAX_AGE_HOURS=24
RELEASE_PROVENANCE_CHECKPOINT_MAX_AGE_HOURS=24
RELEASE_PROVENANCE_KEY_VALID_DAYS=180
RELEASE_PROVENANCE_ROTATION_WARNING_DAYS=30
RELEASE_PROVENANCE_DEFAULT_RETENTION_DAYS=3650
# External anchor/WORM adapters are operator-side argv JSON commands and are intentionally not persisted with secrets here.
