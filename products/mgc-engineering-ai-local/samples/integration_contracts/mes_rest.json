{
  "connector_type": "mes_rest",
  "source_domain": "mes",
  "expected_freshness_minutes": 15,
  "required_fields": ["external_id", "kind", "modified_at", "metadata.vin"],
  "config": {
    "base_url": "http://mes-gateway.internal",
