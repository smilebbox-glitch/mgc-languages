CAD_GATEWAY_VENDOR=kompas
CAD_GATEWAY_PRODUCT=КОМПАС-3D
CAD_GATEWAY_SDK=KOMPAS-3D SDK
CAD_GATEWAY_SDK_VERSION=approved-version
CAD_GATEWAY_REQUIRE_API_KEY=true
CAD_GATEWAY_API_KEY=replace-me
CAD_GATEWAY_EXTENSIONS=.m3d,.a3d,.t3d,.cdw,.frw,.spw,.kdw
CAD_GATEWAY_TARGETS=step,pdf,dxf,txt,xlsx,csv
CAD_GATEWAY_MAX_MB=1000
CAD_GATEWAY_TIMEOUT_SECONDS=300
# Point this to an IT-approved wrapper built with KOMPAS SDK/Automation.
CAD_CONVERTER_EXE=C:\MGC-CAD-Gateway\kompas-converter.exe
CAD_CONVERTER_ARGS_JSON=["--input","{input}","--output","{output}","--target","{target}"]
