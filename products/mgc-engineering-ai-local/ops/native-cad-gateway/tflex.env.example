CAD_GATEWAY_VENDOR=tflex
CAD_GATEWAY_PRODUCT=T-FLEX CAD
CAD_GATEWAY_SDK=T-FLEX CAD Open API
CAD_GATEWAY_SDK_VERSION=approved-version
CAD_GATEWAY_REQUIRE_API_KEY=true
CAD_GATEWAY_API_KEY=replace-me
CAD_GATEWAY_EXTENSIONS=.grb
CAD_GATEWAY_TARGETS=step,pdf,dxf
CAD_GATEWAY_MAX_MB=1000
CAD_GATEWAY_TIMEOUT_SECONDS=300
# The wrapper may inspect a GRB and, for target=auto, write exactly one
# converted.step / converted.pdf / converted.dxf next to {output_base}.
CAD_CONVERTER_EXE=C:\MGC-CAD-Gateway\tflex-converter.exe
CAD_CONVERTER_ARGS_JSON=["--input","{input}","--output-base","{output_base}","--target","{target}"]
