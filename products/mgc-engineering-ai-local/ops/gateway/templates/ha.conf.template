upstream mgc_api_cluster {
    zone mgc_api_cluster 64k;
    server ${API_UPSTREAM_PRIMARY} max_fails=${HA_GATEWAY_MAX_FAILS} fail_timeout=${HA_GATEWAY_FAIL_TIMEOUT};
    server ${API_UPSTREAM_SECONDARY} max_fails=${HA_GATEWAY_MAX_FAILS} fail_timeout=${HA_GATEWAY_FAIL_TIMEOUT};
    keepalive 32;
}
upstream mgc_frontend_cluster {
    zone mgc_frontend_cluster 32k;
    server ${FRONTEND_UPSTREAM_PRIMARY} max_fails=${HA_GATEWAY_MAX_FAILS} fail_timeout=${HA_GATEWAY_FAIL_TIMEOUT};
    server ${FRONTEND_UPSTREAM_SECONDARY} max_fails=${HA_GATEWAY_MAX_FAILS} fail_timeout=${HA_GATEWAY_FAIL_TIMEOUT};
    keepalive 16;
}
server {
    listen 8080;
    client_max_body_size 1024m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    location = /healthz { access_log off; return 200 "ok\n"; add_header Content-Type text/plain; }

    location /api/ {
        proxy_pass http://mgc_api_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer $http_x_forwarded_access_token";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-API-Key ${API_KEY};
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Forwarded-Groups "";
        proxy_read_timeout 300s;
        # Passive failover applies only where nginx considers retry safe. We intentionally
        # do NOT enable the `non_idempotent` option: POST/PATCH/PUT are never blindly replayed.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }
    location = /docs {
        proxy_pass http://mgc_api_cluster/docs;
        proxy_set_header Authorization "Bearer $http_x_forwarded_access_token";
        proxy_set_header X-API-Key ${API_KEY};
    }
    location = /openapi.json {
        proxy_pass http://mgc_api_cluster/openapi.json;
        proxy_set_header Authorization "Bearer $http_x_forwarded_access_token";
        proxy_set_header X-API-Key ${API_KEY};
    }
    location / {
        proxy_pass http://mgc_frontend_cluster;
        proxy_set_header Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }
}
