# Test VM profile for MGC Languages: CPU-only, no server-side AI/TTS.
# Copy to .env.vm. Launchers generate local secrets/passwords automatically.
MGC_BIND_ADDRESS=0.0.0.0
MGC_PORT=8080

POSTGRES_DB=mgc_languages
POSTGRES_USER=mgc_languages
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_MAX_CONNECTIONS=60

AUTH_MODE=local
REGISTRATION_ENABLED=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
MGC_TRUSTED_HOSTS=*
CORS_ORIGINS=
OIDC_STATE_SECRET=CHANGE_ME_OIDC_SECRET

MGC_ADMIN_USERNAME=admin
MGC_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MGC_ADMIN_DISPLAY_NAME=MGC Admin
MGC_ADMIN_DEPARTMENT=Администрация
MGC_ADMIN_SYNC_CREDENTIALS=true

METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# VM test mode: disable server-side pronunciation engine to keep CPU/RAM minimal.
# Browser speech synthesis may still be available on client devices.
TTS_ENABLED=false
TTS_DISK_CACHE_ENABLED=false
TTS_LEGACY_GET_ENABLED=false

# Reduced VM concurrency; core learning, games, XP, scenarios and analytics stay enabled.
WEB_CONCURRENCY=1
UVICORN_LIMIT_CONCURRENCY=100
UVICORN_BACKLOG=512
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

RLS_ENABLED=true
TERM_APPROVAL_REQUIRED=true
PILOT_DAILY_XP_CAP=2500
PILOT_DAILY_GAME_START_CAP=150
PILOT_DAILY_TTS_CAP=0
PILOT_DAILY_PRACTICE_CAP=300

# Test VM resource envelope used by docker-compose.vm.yml.
MGC_APP_MEMORY_LIMIT=1024m
MGC_APP_CPU_LIMIT=1.50
MGC_DB_MEMORY_LIMIT=768m
MGC_DB_CPU_LIMIT=0.75
MGC_NGINX_MEMORY_LIMIT=128m
MGC_NGINX_CPU_LIMIT=0.20
